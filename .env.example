APP_NAME="Telegram Mini App API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (production: MySQL 8) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tma
DB_USERNAME=root
DB_PASSWORD=

# --- Redis ------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- Broadcasting (Reverb) -------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tma
REVERB_APP_KEY=tma-key
REVERB_APP_SECRET=tma-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Filesystem -------------------------------------------------------
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (not used in v1 but kept) ----------------------------------
MAIL_MAILER=log

# --- Sanctum ----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_GUARD=web
# Token TTL in minutes (null = never expires). Default 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

# --- Telegram Mini App ------------------------------------------------
# REQUIRED in production. Obtain from @BotFather.
TELEGRAM_BOT_TOKEN=
# initData freshness window in seconds (replay protection). Default 24h.
TELEGRAM_INIT_DATA_TTL=86400
# When true, bypass HMAC verification for local debugging. NEVER true in prod.
TELEGRAM_ALLOW_UNSIGNED=false

# --- Payments (stub in v1) -------------------------------------------
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=THB
# Platform commission on confirmed payment, 0..1
PAYMENT_COMMISSION=0.15
# Wallet addresses the client is asked to send funds to (manual gateway)
PAYMENT_USDT_ADDRESS=
PAYMENT_BTC_ADDRESS=
PAYMENT_TON_ADDRESS=

# --- CORS -------------------------------------------------------------
# Comma-separated list of allowed origins for the Mini App web view.
CORS_ALLOWED_ORIGINS=https://web.telegram.org

# --- Misc -------------------------------------------------------------
IDEMPOTENCY_TTL=86400
MEETING_PENDING_TTL=600
